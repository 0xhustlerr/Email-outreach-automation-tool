# Optional: GitHub personal access token (classic or fine-grained, public-repo read is enough).
# Raises the rate limit from 60 req/h (unauthenticated) to 5,000 req/h.
# Leave unset to run anonymously.
GITHUB_TOKEN=

# Optional: default value of the "Commits per repo" UI input.
NEXT_PUBLIC_DEFAULT_COMMITS_PER_REPO=5

# Optional: max number of repos scanned in "All repositories" mode (server-side).
SCAN_REPO_LIMIT=30

# --- Outbound email (optional) --------------------------------------
# Required to enable the "Send" button in the UI. Any SMTP server works.
# Each identity below carries its own app password, so each From: authenticates
# as itself (Gmail rejects mismatched From headers).
#
# For Gmail each account needs:
#   1. 2-Step Verification enabled
#   2. An App Password created at https://myaccount.google.com/apppasswords
#      (the 16-char string, spaces optional — "abcd efgh ijkl mnop" works fine)
#
# Top-level SMTP_* vars are the fallback for any identity that omits its own creds.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# JSON array of identities. Each can override SMTP fields (host/port/secure/user/pass).
# For Gmail, smtpHost/Port/Secure can be omitted — they inherit from the top-level vars.
MAIL_IDENTITIES=[
  {"name":"Account A","email":"acct-a@gmail.com","smtpUser":"acct-a@gmail.com","smtpPass":"abcd efgh ijkl mnop"},
  {"name":"Account B","email":"acct-b@gmail.com","smtpUser":"acct-b@gmail.com","smtpPass":"qrst uvwx yzab cdef"}
]

# --- Google Sheets send log (optional) ------------------------------
# When set, every successful send appends a row to a Google Sheet.
# Setup:
#   1. Open the sheet → Extensions → Apps Script
#   2. Paste scripts/sheet-logger.gs into Code.gs, save
#   3. (Optional) File → Project Properties → Script Properties → add
#      SHEET_WEBHOOK_SECRET=<some random string>
#   4. Deploy → New deployment → type "Web app"
#      - Execute as: "Me"
#      - Who has access: "Anyone"
#   5. Copy the /exec URL into SHEETS_WEBHOOK_URL below.
#   6. For "History" in the app: after updating scripts/sheet-logger.gs,
#      Deploy → Manage deployments → Edit → New version → Deploy (required
#      whenever the Apps Script file changes — saving alone is not enough).
# Leave SHEETS_WEBHOOK_URL unset to disable logging entirely.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
# Sheet tab name. Defaults to "Table1" to match the existing template.
SHEETS_TAB_NAME=Table1

# --- Gmail reply sync (optional) ------------------------------------
# Detects when a recipient replies to your outreach and sets Active=yes
# and Reply=yes on matching sheet rows. Requires Gmail API OAuth (read-only).
#
# Setup (once per Google Cloud project):
#   1. https://console.cloud.google.com → APIs → enable Gmail API
#   2. Credentials → OAuth client ID (Desktop app or Web)
#   3. OAuth consent screen → add scope gmail.readonly
#   4. Use OAuth Playground or a one-time script to obtain refresh tokens
#      for each sender inbox you send from.
#
# One account:
#   GMAIL_CLIENT_ID=
#   GMAIL_CLIENT_SECRET=
#   GMAIL_SYNC_ACCOUNT=imagesatomic@gmail.com
#   GMAIL_REFRESH_TOKEN=
#
# Multiple sender inboxes (recommended if you use several From: addresses):
#   GMAIL_REFRESH_TOKENS={"imagesatomic@gmail.com":"1//...","dwicenterlifechanges@gmail.com":"1//..."}
#
# If an inbox used a different OAuth client in Playground, set its client per account:
#   GMAIL_OAUTH_BY_ACCOUNT={"dwicenterlifechanges@gmail.com":{"clientId":"....apps.googleusercontent.com","clientSecret":"..."}}
#
# Your sheet only needs an "active" column (e.g. yes/no dropdown).
# Optional extra columns: replied, replied at
# Redeploy scripts/sheet-logger.gs after updating (new version).
#
# GMAIL_SYNC_MAX_CHECKS=120 limits Gmail API calls per sync (newest rows first).
#
# Live inbox polling while the app is open (no manual refresh needed):
# NEXT_PUBLIC_INBOX_POLL_MS=45000
# NEXT_PUBLIC_REPLY_SYNC_MS=60000

# --- Knock in-app notifications (optional) ---------------------------------
# Real-time reply toasts + notification bell (https://knock.app).
# Based on: https://github.com/knocklabs/in-app-notifications-example-nextjs
#
# 1. Create a Knock account, in-app feed channel, and workflow (default key: in-app)
# 2. Workflow must include an in-app channel step; template can use {{ message }}
# 3. Add a test user id matching KNOCK_RECIPIENT_USER_ID
#
# KNOCK_SECRET_API_KEY=
# NEXT_PUBLIC_KNOCK_PUBLIC_API_KEY=
# NEXT_PUBLIC_KNOCK_FEED_CHANNEL_ID=
# KNOCK_RECIPIENT_USER_ID=email-finder-user
# KNOCK_WORKFLOW_KEY=in-app
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_SYNC_ACCOUNT=
GMAIL_REFRESH_TOKEN=
GMAIL_REFRESH_TOKENS=
GMAIL_SYNC_MAX_CHECKS=120
